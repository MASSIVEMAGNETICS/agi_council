{
  "name": "omniforge-council",
  "version": "2.0.0",
  "description": "OmniForge Multi-LLM Council - Enterprise multi-platform AI orchestration system",
  "main": "dist/api/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/api/index.ts",
    "dev:client": "vite",
    "dev:legacy": "tsx watch platforms/legacy/server/index.ts",
    "build": "npm run build:core && npm run build:api && npm run build:web && npm run build:legacy",
    "build:core": "tsc -p tsconfig.core.json",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "vite build --config platforms/web/vite.config.ts",
    "build:legacy": "tsc -p tsconfig.legacy.json",
    "build:desktop": "npm run build:core && npm run build:api && electron-builder",
    "start": "node dist/api/index.js",
    "start:legacy": "node dist/legacy/server/index.js",
    "lint": "eslint src platforms --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "ai",
    "multi-agent",
    "llm",
    "council",
    "orchestration",
    "asi",
    "enterprise",
    "multi-platform",
    "ios",
    "android",
    "web",
    "desktop"
  ],
  "author": "MASSIVEMAGNETICS",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "framer-motion": "^10.16.4",
    "helmet": "^7.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "ws": "^8.14.2",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@capacitor/android": "^5.5.1",
    "@capacitor/cli": "^5.5.1",
    "@capacitor/core": "^5.5.1",
    "@capacitor/ios": "^5.5.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-react": "^4.1.1",
    "concurrently": "^8.2.2",
    "electron": "^27.1.2",
    "electron-builder": "^24.9.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  }
}
